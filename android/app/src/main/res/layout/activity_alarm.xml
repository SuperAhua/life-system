<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBFAF7"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingLeft="28dp"
    android:paddingRight="28dp"
    android:paddingTop="56dp"
    android:paddingBottom="40dp">

    <TextView
        android:id="@+id/alarmClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:letterSpacing="0.12"
        android:textColor="#9A958C"
        android:text="07:30" />

    <TextView
        android:id="@+id/alarmName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textSize="30sp"
        android:lineSpacingExtra="6dp"
        android:textStyle="bold"
        android:textColor="#14120F"
        android:text="运动 30 分钟" />

    <TextView
        android:id="@+id/alarmMin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textSize="15sp"
        android:lineSpacingExtra="7dp"
        android:textColor="#5F5A52"
        android:text="做不动就做这个：换好衣服，做 1 组" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnDone"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:text="做了" />

    <Button
        android:id="@+id/btnMin"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="12dp"
        android:textSize="16sp"
        android:textColor="#2E7D5B"
        android:text="只做最小版" />

    <Button
        android:id="@+id/btnSnooze"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:textSize="15sp"
        android:textColor="#8A857C"
        android:text="10 分钟后再提醒" />

</LinearLayout>
